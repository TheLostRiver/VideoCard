{
  "name": "video-card-gpu-ladder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.13.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "serve:db": "node scripts/serve.mjs --database",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "sync:data": "node scripts/sync-gpus.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "export:static": "node scripts/export-static-data.mjs",
    "validate:hardware": "node scripts/validate-hardware-data.mjs",
    "verify": "npm run validate:data && npm run validate:hardware && npm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/run-migration.mjs",
    "db:seed": "node scripts/seed-database.mjs",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed"
  }
}
